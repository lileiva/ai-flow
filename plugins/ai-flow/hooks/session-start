#!/usr/bin/env bash
# SessionStart hook for ai-flow plugin

set -euo pipefail

# Check peer dependencies
warnings=""

# Check superpowers plugin
superpowers_found=false
if [ -d "${HOME}/.claude/plugins/cache/claude-plugins-official/superpowers" ] 2>/dev/null; then
  superpowers_found=true
fi
# Also check sibling plugin directories
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -d "$(dirname "${CLAUDE_PLUGIN_ROOT}")/superpowers" ] 2>/dev/null; then
  superpowers_found=true
fi
if [ "$superpowers_found" = false ]; then
  warnings+=$'\n'"- **superpowers plugin not found** -- systematic-debugging, brainstorming, and verification skills will be unavailable. Install with: \`claude plugin add superpowers\`"
fi

# Check engram
if ! command -v engram &>/dev/null 2>&1; then
  warnings+=$'\n'"- **engram not found** -- AI-Flow artifact persistence will use inline-only mode. Install from: https://github.com/gentleman-programming/engram"
fi

# Escape string for JSON embedding using bash parameter substitution
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Fixed pointer; the protocol itself is loaded on demand via the Skill tool.
pointer="AI-Flow is installed. For AI-Flow requests or any /ai-flow:* command, load skill ai-flow:using-ai-flow first. This conversation is the coordinator: gates and user questions happen here, and phase work runs in ai-flow:* agents. Do not hand coordination to another agent."
session_context="$(escape_for_json "${pointer}${warnings}")"

# Output context injection as JSON.
# Claude Code sets CLAUDE_PLUGIN_ROOT -- emit only hookSpecificOutput
# Other platforms (Cursor, etc.) -- emit only additional_context
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${session_context}"
  }
}
EOF
else
  cat <<EOF
{
  "additional_context": "${session_context}"
}
EOF
fi

exit 0
